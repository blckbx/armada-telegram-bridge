# Copy this file to .env, replace every placeholder, and run: chmod 600 .env
# Never place real credentials in this sample file.

# Runtime credentials used by P02 and later parts.
ARMADA_NSEC=<nsec1...>
TELEGRAM_BOT_TOKEN=<numeric-bot-id:token>

# P01 live-test scope. Runtime scope comes from bridge.toml.
ARMADA_BRIDGE_LIVE_EXPECTED_NPUB=<npub1...>
ARMADA_BRIDGE_LIVE_COMMUNITY_ID=<64-character-community-id>
ARMADA_BRIDGE_LIVE_CHANNEL_ID=<64-character-private-channel-id>

# Required only by configured_channel_can_receive.
ARMADA_BRIDGE_LIVE_RECEIVE_MARKER=<unique-harmless-marker-from-armada>
ARMADA_BRIDGE_LIVE_EXPECTED_AUTHOR_NPUB=<npub1...>

# Required only by configured_channel_can_send.
ARMADA_BRIDGE_LIVE_SEND_MARKER=<unique-harmless-marker-for-armada>

# Required only by the ignored P09 live attachment upload tests.
ARMADA_BRIDGE_LIVE_FILE=<absolute-path-to-disposable-file-under-20MB>

# Required only by the ignored P10 live reply/edit event-shape test. Start the
# test, send the reply marker as a threaded Armada reply, then edit it to the
# second marker.
ARMADA_BRIDGE_LIVE_P10_REPLY_MARKER=<unique-harmless-reply-marker>
ARMADA_BRIDGE_LIVE_P10_EDIT_MARKER=<unique-harmless-edited-marker>

# Required only by the ignored P10 live expiry event-shape test. Send this as a
# self-destructing Armada message while the test is waiting.
ARMADA_BRIDGE_LIVE_P10_EXPIRY_MARKER=<unique-harmless-expiring-marker>
